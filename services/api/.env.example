# Copy to .env and fill in. Never commit .env (see .gitignore).

# Local docker-compose Postgres — host port 5433 (docs/DEVIATIONS.md 0.1).
DATABASE_URL=postgresql+psycopg://storyforge:storyforge@localhost:5433/storyforge

# --- Phase 3+ ---
# §3: model IDs live in env, never hardcoded.
ANTHROPIC_API_KEY=
# Sonnet-class for generation/rewrite, Haiku-class for tagging/moderation (§3).
# Use the bare aliases — never append date suffixes.
ANTHROPIC_MODEL_GENERATE=claude-sonnet-5
ANTHROPIC_MODEL_FAST=claude-haiku-4-5
# Optional. Overrides the GENERATING node's read timeout, default 240s
# (DEVIATIONS 8.1, re-derived in 8.7 — max_tokens / measured throughput).
# `max_retries=2` multiplies it by three, so a dead cell costs ~3x this value.
# Pin it low (e.g. 2) to make the real SDK raise a real APITimeoutError and check
# that `make warm` takes §7's fallback instead of aborting the whole run.
# ANTHROPIC_GENERATION_TIMEOUT_S=240

LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# --- Phase 6 ---
CLERK_JWKS_URL=
CLERK_SECRET_KEY=

# §18 demo fallback. MUST remain false in any deployed environment.
#
# It is not documentation that keeps it there: `auth.assert_demo_bypass_is_local`
# refuses to START the process when anything suggests a deployment — an
# environment-name variable naming prod/stag/live/prd/uat, a platform-injected
# variable (`PORT`, `K_SERVICE`, `DIGITALOCEAN_APP_ID`, …) whether it has a value
# or has been deliberately blanked, a non-local or container database host, an
# `sk_live_` Clerk key, or the process being inside a container at all. The
# refusal names the signal it saw (DEVIATIONS 7.36, 8.64-8.66).
DEMO_BYPASS_AUTH=false

# Cancels the CONTAINER signal above, and nothing else — every other signal still
# refuses while it is set. For a dev container or a containerised CI runner, which
# would otherwise fail at import with a message about production. Do not set it on
# a host anyone else can reach: with the bypass on, every request becomes one
# fixed local parent with no token at all.
# STORYFORGE_BYPASS_IN_CONTAINER=i-understand-this-disables-auth
